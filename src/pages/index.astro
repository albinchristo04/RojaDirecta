---
import Layout from '../layouts/Layout.astro';
import MatchCard from '../components/MatchCard.astro';
import { getMatches } from '../utils/data';

const matches = await getMatches();

const title = "Roja Directa En Vivo - Fútbol en Vivo Hoy - Roja Directa Fútbol Gratis";
const description = "Ver fútbol en vivo hoy gratis en Roja Directa En Vivo. La mejor alternativa a Rojadirecta para ver roja directa fútbol gratis y deportes online HD sin cortes.";
const headerTitle = "ROJA DIRECTA EN VIVO - FÚTBOL EN VIVO HOY";
---

<Layout title={title} description={description} headerTitle={headerTitle}>
	<div class="container">

        <!-- Homepage Banner Ad -->
        <div class="container" style="text-align: center; margin: 2rem 0;">
            <script>
              atOptions = {
                'key' : '0669cb9f720396db47ff6c5c8e8b7a9e',
                'format' : 'iframe',
                'height' : 250,
                'width' : 300,
                'params' : {}
              };
            </script>
            <script src="https://www.highperformanceformat.com/0669cb9f720396db47ff6c5c8e8b7a9e/invoke.js"></script>
        </div>

        <div class="schedule-box">
            <div class="schedule-header">
                <span class="globe-icon">🌍</span>
                ROJA DIRECTA FÚTBOL GRATIS - SCHEDULE
            </div>
            <div class="matches-list">
                {matches.length > 0 ? (
                    matches.map((match) => (
                        <MatchCard match={match} />
                    ))
                ) : (
                    <div class="no-matches">No hay partidos de <strong>fútbol en vivo hoy</strong> programados en este momento.</div>
                )}
            </div>
        </div>
        



        <section class="seo-content">
            <div class="content-box">
                <div class="seo-header">
                    <img src="/favicon.svg" alt="Roja Directa En Vivo - Fútbol Gratis" width="50" height="50" />
                    <h2>Watch Live Football on <strong>Tarjeta Roja</strong> - The Best Alternative</h2>
                </div>
                
                <p>
                    Bienvenido a <strong>Roja Directa En Vivo</strong>, el portal líder para disfrutar de <strong>fútbol en vivo hoy</strong> de forma totalmente gratuita. 
                    Si estás buscando una alternativa confiable a <strong>Rojadirecta</strong> o Pirlo TV para ver <strong>roja directa fútbol gratis</strong>, estás en el lugar correcto.
                </p>
                
                <p>
                    Ofrecemos transmisiones de alta calidad para todas las ligas principales, incluyendo LaLiga, Premier League, Champions League y más. 
                    Nuestros enlaces de <strong>roja directa en vivo</strong> se actualizan en tiempo real para asegurar que nunca te pierdas un gol de tu equipo favorito.
                </p>

                <h3>¿Por qué elegir nuestra plataforma de Roja Directa?</h3>
                <p>
                    En el mundo del <strong>fútbol gratis</strong>, la velocidad y la estabilidad son fundamentales. Por eso, nuestra infraestructura está optimizada 
                    para ofrecerte la mejor experiencia de usuario al buscar <strong>rojadirecta</strong> online. Aquí podrás ver todos los partidos de 
                    <strong>fútbol en vivo hoy</strong> sin necesidad de registros complicados ni suscripciones costosas.
                </p>
            </div>
        </section>


    </div>

</Layout>

<style>
    .schedule-box {
        background: #222;
        border-radius: 8px;
        overflow: hidden;
        margin-top: 2rem;
        border: 1px solid #333;
    }

    .schedule-header {
        background: #1a1a1a;
        color: #ffc107;
        padding: 1rem;
        text-align: center;
        font-weight: 800;
        font-size: 1.1rem;
        border-bottom: 2px solid #d32f2f;
    }

    .globe-icon {
        margin-right: 0.5rem;
    }

    .matches-list {
        background: white;
    }

    .no-matches {
        padding: 2rem;
        text-align: center;
        color: #666;
        background: white;
    }

    .seo-content {
        margin-top: 3rem;
        background: white;
        color: #333;
        padding: 2rem;
        border-radius: 8px;
        border-left: 5px solid #d32f2f;
    }

    .seo-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .seo-content h2 {
        color: #d32f2f;
        margin: 0;
        font-size: 1.5rem;
    }

    .seo-content h3 {
        color: #d32f2f;
        margin: 1.5rem 0 1rem;
        font-size: 1.2rem;
    }

    .seo-content p {
        margin-bottom: 1rem;
        line-height: 1.8;
    }

    .seo-content strong {
        color: var(--primary);
    }
</style>
